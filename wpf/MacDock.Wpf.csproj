<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MacDock.Wpf</AssemblyName>
    <Version>0.4.6</Version>
    <ApplicationIcon>Assets/macdock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <!-- WPF owns process DPI awareness through the manifest; Forms is used only for tray/monitor APIs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/macdock.ico" />
    <EmbeddedResource Include="Assets/macdock-tray.ico" LogicalName="MacDock.TrayIcon" />
  </ItemGroup>
</Project>
